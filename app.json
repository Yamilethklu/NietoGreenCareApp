{
  "expo": {
    "name": "Nieto Green Care",
    "slug": "nieto-green-care",
    "version": "1.1.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "nietogreencare",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#dcfce7"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos de trabajos para la galería.",
          "cameraPermission": "Permite tomar fotos de trabajos terminados."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4332"
        }
      ],
      "expo-sharing",
      "expo-font"
    ],
    "ios": {
      "buildNumber": "10",
      "supportsTablet": true,
      "bundleIdentifier": "com.nietogreencare.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.nietogreencare.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dcfce7"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "versionCode": 10
    },
    "web": {
      "bundler": "metro"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee66ff82-78c1-4a92-801d-28ed5ec36feb"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ee66ff82-78c1-4a92-801d-28ed5ec36feb",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "runtimeVersion": "1.1.9"
  }
}
