{
  "expo": {
    "name": "Nieto Green Care",
    "slug": "nieto-green-care",
    "scheme": "nietogreencare",
    "version": "1.1.9",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#dcfce7"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos de trabajos para la galería.",
          "cameraPermission": "Permite tomar fotos de trabajos terminados."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B4332"
        }
      ],
      "expo-sqlite",
      "expo-web-browser"
    ],
    "ios": {
      "buildNumber": "14",
      "supportsTablet": true,
      "bundleIdentifier": "com.nietogreencare.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "runtimeVersion": "1.1.9"
    },
    "android": {
      "package": "com.nietogreencare.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#dcfce7"
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            {
              "scheme": "nietogreencare",
              "host": "admin"
            },
            {
              "scheme": "nietogreencare",
              "host": "auth",
              "pathPrefix": "/callback"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "runtimeVersion": "1.1.10"
    },
    "web": {
      "bundler": "metro"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/ee66ff82-78c1-4a92-801d-28ed5ec36feb"
    },
    "runtimeVersion": "1.1.9",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ee66ff82-78c1-4a92-801d-28ed5ec36feb"
      }
    }
  }
}
