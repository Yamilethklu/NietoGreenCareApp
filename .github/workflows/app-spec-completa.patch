+import { useEffect, useState } from 'react';
+import { Modal, Pressable, SafeAreaView, ScrollView, Text, TextInput, View } from 'react-native';
+import { STATUSES, isDate, type Order, type Status } from '../src/panel';
+
+const input = { borderWidth: 1, borderColor: '#86efac', backgroundColor: '#fff', color: '#111827', borderRadius: 8, padding: 12, marginTop: 4, marginBottom: 10 } as const;
+const label = { fontWeight: '700', color: '#14532d' } as const;
+
+export type OrderChanges = { service_date: string; price: number; notes: string | null; status: 'scheduled' | 'completed' | 'cancelled' };
+
+export function OrderEditModal({ order, onClose, onSave }: { order: Order | null; onClose: () => void; onSave: (order: Order, changes: OrderChanges) => Promise<void> }) {
+  const [date, setDate] = useState('');
+  const [price, setPrice] = useState('');
+  const [notes, setNotes] = useState('');
+  const [status, setStatus] = useState<Status>('SOLICITADA');
+  const [error, setError] = useState('');
+  const [saving, setSaving] = useState(false);
+
+  useEffect(() => {
+    if (!order) return;
+    setDate(order.date); setPrice(String(order.price)); setNotes(order.notes ?? ''); setStatus(order.status); setError('');
+  }, [order]);
+
+  if (!order) return null;
+
+  async function save() {
+    if (!order || saving) return;
+    const amount = Number(price.replace(',', '.'));
+    if (!isDate(date)) { setError('Escribe la fecha como AAAA-MM-DD.'); return; }
+    if (!Number.isFinite(amount) || amount < 0) { setError('Escribe un precio válido.'); return; }
+    setSaving(true); setError('');
+    try {
+      await onSave(order, { service_date: date, price: amount, notes: notes.trim() || null, status: status === 'FINALIZADA' ? 'completed' : status === 'CANCELADA' ? 'cancelled' : 'scheduled' });
+    } catch (cause) { setError(cause instanceof Error ? cause.message : 'No se pudo guardar.'); }
+    finally { setSaving(false); }
+  }
+
+  return (
+    <Modal visible animationType="slide" onRequestClose={onClose}>
+      <SafeAreaView style={{ flex: 1, backgroundColor: '#f8fafc' }}>
+        <ScrollView contentContainerStyle={{ padding: 16 }}>
+          <Text style={{ fontSize: 20, fontWeight: '800', color: '#14532d' }}>Editar orden</Text>
+          <Text style={{ color: '#475569', marginBottom: 12 }}>{order.service}</Text>
+          <Text style={label}>Fecha</Text>
+          <TextInput style={input} value={date} onChangeText={setDate} placeholder="AAAA-MM-DD" autoCapitalize="none" />
+          <Text style={label}>Precio</Text>
+          <TextInput style={input} value={price} onChangeText={setPrice} keyboardType="decimal-pad" />
+          <Text style={label}>Estado</Text>
+          <View style={{ flexDirection: 'row', gap: 8, marginVertical: 8 }}>
+            {STATUSES.map((item) => (
+              <Pressable key={item} onPress={() => setStatus(item)} style={{ flex: 1, padding: 10, borderRadius: 8, borderWidth: 1, borderColor: '#86efac', backgroundColor: status === item ? '#bbf7d0' : '#fff' }}>
+                <Text style={{ textAlign: 'center', fontSize: 12, fontWeight: '700' }}>{item}</Text>
+              </Pressable>
+            ))}
+          </View>
+          <Text style={label}>Notas</Text>
+          <TextInput style={[input, { minHeight: 80 }]} value={notes} onChangeText={setNotes} multiline />
+          {error ? <Text accessibilityRole="alert" style={{ color: '#b91c1c', marginBottom: 8 }}>{error}</Text> : null}
+          <Pressable disabled={saving} onPress={() => void save()} style={{ backgroundColor: '#15803d', padding: 14, borderRadius: 8, opacity: saving ? 0.6 : 1 }}>
+            <Text style={{ color: '#fff', textAlign: 'center', fontWeight: '700' }}>{saving ? 'Guardando...' : 'Guardar cambios'}</Text>
+          </Pressable>
+          <Pressable onPress={onClose} style={{ padding: 14 }}><Text style={{ textAlign: 'center', color: '#475569' }}>Cancelar</Text></Pressable>
+        </ScrollView>
+      </SafeAreaView>
+    </Modal>
+  );
+}
diff --git a/components/WorkerSchedule.tsx b/components/WorkerSchedule.tsx
new file mode 100644
index 0000000..177a1de
--- /dev/null
+++ b/components/WorkerSchedule.tsx
@@ -0,0 +1,59 @@
+import { Pressable, Text, View } from 'react-native';
+import { Ionicons } from '@expo/vector-icons';
+import { shiftDate, type House, type Order, type Worker } from '../src/panel';
+
+const box = { backgroundColor: '#fff', borderRadius: 10, borderWidth: 1, borderColor: '#bbf7d0', padding: 12, marginTop: 10 } as const;
+
+export function WorkerSchedule({ workers, orders, houses, date, onDate, onOpenCalendar, onAssign }: {
+  workers: Worker[]; orders: Order[]; houses: House[]; date: string; onDate: (date: string) => void; onOpenCalendar: () => void; onAssign: (orderId: string, workerId: string | null) => void;
+}) {
+  const day = orders.filter((order) => order.date === date && order.status !== 'CANCELADA');
+  const active = workers.filter((worker) => worker.active);
+  const addressOf = (order: Order) => houses.find((house) => house.id === order.houseId)?.address ?? 'Dirección pendiente';
+  const unassigned = day.filter((order) => !order.workerId || !active.some((worker) => worker.id === order.workerId));
+
+  return (
+    <View style={{ marginTop: 18 }}>
+      <Text style={{ fontSize: 20, fontWeight: '800', color: '#14532d' }}>Casas por trabajador</Text>
+      <View style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', marginTop: 8 }}>
+        <Pressable onPress={() => onDate(shiftDate(date, -1))} style={{ padding: 8 }}><Ionicons name="chevron-back" size={22} color="#14532d" /></Pressable>
+        <Pressable onPress={onOpenCalendar} style={{ flexDirection: 'row', alignItems: 'center', gap: 6 }}><Ionicons name="calendar-outline" size={18} color="#14532d" /><Text style={{ fontWeight: '800' }}>{date}</Text></Pressable>
+        <Pressable onPress={() => onDate(shiftDate(date, 1))} style={{ padding: 8 }}><Ionicons name="chevron-forward" size={22} color="#14532d" /></Pressable>
+      </View>
+
+      {active.map((worker) => {
+        const mine = day.filter((order) => order.workerId === worker.id);
+        return (
+          <View key={worker.id} style={box}>
+            <Text style={{ fontWeight: '800' }}>{worker.name} · {mine.length} {mine.length === 1 ? 'casa' : 'casas'}</Text>
+            {mine.map((order) => (
+              <View key={order.id} style={{ flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingVertical: 6 }}>
+                <Text style={{ flex: 1 }}>{addressOf(order)}</Text>
+                <Pressable onPress={() => onAssign(order.id, null)}><Text style={{ color: '#b91c1c', fontWeight: '700' }}>Quitar</Text></Pressable>
+              </View>
+            ))}
+            {!mine.length ? <Text style={{ color: '#64748b', marginTop: 4 }}>Sin casas asignadas este día.</Text> : null}
+          </View>
+        );
+      })}
+
+      <View style={box}>
+        <Text style={{ fontWeight: '800' }}>Sin asignar · {unassigned.length}</Text>
+        {unassigned.map((order) => (
+          <View key={order.id} style={{ paddingVertical: 8, borderBottomWidth: 1, borderColor: '#e2e8f0' }}>
+            <Text>{addressOf(order)}</Text>
+            <View style={{ flexDirection: 'row', flexWrap: 'wrap', gap: 6, marginTop: 6 }}>
+              {active.map((worker) => (
+                <Pressable key={worker.id} onPress={() => onAssign(order.id, worker.id)} style={{ paddingVertical: 6, paddingHorizontal: 10, borderRadius: 16, backgroundColor: '#bbf7d0' }}>
+                  <Text style={{ fontWeight: '700', fontSize: 12 }}>{worker.name}</Text>
+                </Pressable>
+              ))}
+            </View>
+          </View>
+        ))}
+        {!unassigned.length ? <Text style={{ color: '#64748b', marginTop: 4 }}>Todas las casas del día tienen trabajador.</Text> : null}
+        {!active.length ? <Text style={{ color: '#64748b', marginTop: 4 }}>Registra trabajadores arriba para poder asignarles casas.</Text> : null}
+      </View>
+    </View>
+  );
+}
